{
  "title": "Ello: outbound GTM system",
  "subtitle": "DRAFT 2026-11-13, drawn from context/docs/gtm-system.md. Untested. Row 1 reads left to right, row 2 right to left, row 3 left to right.",
  "rows": [
    {"title": "Find and qualify accounts (steps 1 to 5)", "direction": "ltr",
     "columns": ["1A", "1B", "1C", "1D", "1E", "1F", "1G", "1H", "1I"]},
    {"title": "Route, find people, find emails (steps 6 to 8)", "direction": "rtl",
     "columns": ["2A", ["2B", "2C", "2D"], "2E", "2F", "2G", "2H", "2I"]},
    {"title": "Send, sort replies, CRM, weekly loop (steps 9 to 12)", "direction": "ltr",
     "columns": ["3A", "3B", ["o1", "o2", "o3", "o4", "o5", "o6"], ["a1", "a2", "a3", "a4", "a5", "a6"], "3C", "3D", "3E", "3F"]}
  ],
  "nodes": {
    "1A": {"kind": "start", "title": "Context OS", "sub": "ICP, personas, signal matrix, facts, rules", "tools": ["claude_code", "github"], "w": 300},
    "1B": {"kind": "step", "title": "Buying signals", "sub": ["DM-to-order and food posts", "Hiring a CS or order rep", "New Meta ad", "\"Couldn't reach\" reviews", "New opening"], "tools": ["n8n", "treg"]},
    "1C": {"kind": "decision", "title": "Lagos, recent?"},
    "drop1": {"kind": "exit", "title": "Drop: stale or outside Lagos", "below": "1C"},
    "1D": {"kind": "step", "title": "Find companies", "sub": "One account per Instagram handle or Maps place ID", "tools": ["clay"]},
    "1E": {"kind": "decision", "title": "In HubSpot?"},
    "hold1": {"kind": "exit", "title": "Stop or hold 90 days", "below": "1E"},
    "1F": {"kind": "step", "title": "Enrich", "sub": "Profile, Maps, reviews, ads; AI tags vertical", "tools": ["clay", "claude"]},
    "1G": {"kind": "decision", "title": "ICP fit?"},
    "drop2": {"kind": "exit", "title": "Drop, or park S4/S5", "below": "1G"},
    "1H": {"kind": "decision", "title": "CAC registered?"},
    "hold2": {"kind": "exit", "title": "Not ready, recheck monthly", "below": "1H"},
    "1I": {"kind": "step", "title": "Tier the account", "sub": "A: 2+ signals. B: 1 signal", "tools": ["clay"]},

    "2A": {"kind": "decision", "title": "Segment?"},
    "2B": {"kind": "branch", "title": "S1 Instagram retail", "sub": "Instagram bio as business desk", "w": 280},
    "2C": {"kind": "branch", "title": "S2 Food", "sub": "Take orders without taking every call", "w": 280},
    "2D": {"kind": "branch", "title": "S3 Salons", "sub": "Turn \"Are you available?\" into a booking", "w": 280},
    "2E": {"kind": "step", "title": "Pick the opener", "sub": "Strongest signal leads; competitor seen means a factual comparison", "tools": ["clay"], "w": 280},
    "2F": {"kind": "step", "title": "Find people", "sub": "Owner from bio, Maps replies, CAC, LinkedIn; else the business team", "tools": ["clay", "claude"], "w": 280},
    "2G": {"kind": "step", "title": "Find and verify email", "sub": "Domain: waterfall. No domain: public profile email", "tools": ["clay"], "w": 280},
    "2H": {"kind": "decision", "title": "Email valid?"},
    "manual": {"kind": "exit", "title": "No email or LinkedIn: manual DM queue", "below": "2H", "w": 260},
    "2I": {"kind": "step", "title": "Assign tracks", "sub": ["Valid: email track", "Catch-all: low-volume pool", "LinkedIn found: LinkedIn track"], "tools": ["clay"], "w": 280},

    "3A": {"kind": "step", "title": "Send the sequence", "sub": ["4 emails, 2 LinkedIn touches, 14 days", "Inbox test first", "Fredrick approves launch"], "tools": ["Sequencer TBD"], "w": 300},
    "3B": {"kind": "step", "title": "Sort replies", "sub": "AI classifies; low confidence goes to a human", "tools": ["n8n", "claude"]},
    "o1": {"kind": "branch", "title": "Interested", "h": 80},
    "o2": {"kind": "branch", "title": "Objection", "h": 80},
    "o3": {"kind": "branch", "title": "Not now", "h": 80},
    "o4": {"kind": "branch", "title": "Wrong person", "h": 80},
    "o5": {"kind": "branch", "title": "Unsubscribe", "h": 80},
    "o6": {"kind": "branch", "title": "Signed up", "h": 80},
    "a1": {"kind": "step", "title": "Task same day, reply from facts", "w": 300, "h": 80, "tools": ["hubspot"]},
    "a2": {"kind": "step", "title": "Objection reply, log competitor", "w": 300, "h": 80, "tools": ["hubspot"]},
    "a3": {"kind": "exit", "title": "Suppress 90 days, back on new signal", "w": 300, "h": 80},
    "a4": {"kind": "exit", "title": "Ask for the owner, back to 2F", "w": 300, "h": 80},
    "a5": {"kind": "exit", "title": "Suppress on all channels", "w": 300, "h": 80},
    "a6": {"kind": "step", "title": "Mark signed up, hand to onboarding", "w": 300, "h": 80, "tools": ["hubspot"]},
    "3C": {"kind": "step", "title": "Signed up (Free)", "w": 190, "h": 100},
    "3D": {"kind": "step", "title": "Verified and live", "w": 190, "h": 100},
    "3E": {"kind": "step", "title": "Paid plan", "w": 190, "h": 100},
    "3F": {"kind": "start", "title": "Weekly review", "sub": "Kill or keep signals; update ICP, personas, learnings", "tools": ["n8n", "claude_code"], "w": 300, "align": "bottom"}
  },
  "edges": [
    ["1A", "1B"], ["1B", "1C"],
    ["1C", "1D", "Yes"], ["1C", "drop1", "No"],
    ["1D", "1E"],
    ["1E", "1F", "No"], ["1E", "hold1", "Yes"],
    ["1F", "1G"],
    ["1G", "1H", "Yes"], ["1G", "drop2", "No"],
    ["1H", "1I", "Yes"], ["1H", "hold2", "No"],
    ["1I", "2A"],
    ["2A", "2B"], ["2A", "2C"], ["2A", "2D"],
    ["2B", "2E"], ["2C", "2E"], ["2D", "2E"],
    ["2E", "2F"], ["2F", "2G"], ["2G", "2H"],
    ["2H", "2I", "Yes"], ["2H", "manual", "No"],
    ["2I", "3A"],
    ["3A", "3B"],
    ["3B", "o1"], ["3B", "o2"], ["3B", "o3"], ["3B", "o4"], ["3B", "o5"], ["3B", "o6"],
    ["o1", "a1"], ["o2", "a2"], ["o3", "a3"], ["o4", "a4"], ["o5", "a5"], ["o6", "a6"],
    ["a6", "3C"], ["3C", "3D"], ["3D", "3E"], ["3E", "3F"]
  ],
  "loop": {"from": "3F", "to": "1A", "label": "Every Monday: results update the Context OS"}
}
